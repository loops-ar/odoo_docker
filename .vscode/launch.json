{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Odoo: Attach",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 8888
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/addons",
          "remoteRoot": "/mnt/extra-addons"
        }
      ],
      "preLaunchTask": "init docker",
      "postDebugTask": "stop docker"
    }
  ]
}